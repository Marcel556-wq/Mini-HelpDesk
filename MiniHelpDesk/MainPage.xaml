<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:MiniHelpDesk.Models"
    x:Class="MiniHelpDesk.MainPage"
    Title="Mini HelpDesk"
    BackgroundColor="#F1F5F9">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label
                Text="Mini HelpDesk"
                FontSize="30"
                FontAttributes="Bold"
                TextColor="#172554" />

            <Label
                Text="System zarządzania zgłoszeniami technicznymi"
                FontSize="14"
                TextColor="#64748B" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

                <Border
                    BackgroundColor="White"
                    Padding="16"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 12">

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Wszystkie zgłoszenia"
                               TextColor="#64748B"
                               FontSize="12" />

                        <Label Text="{Binding TotalTickets}"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="#1D4ED8" />
                    </VerticalStackLayout>
                </Border>

                <Border
                    Grid.Column="1"
                    BackgroundColor="White"
                    Padding="16"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 12">

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Otwarte zgłoszenia"
                               TextColor="#64748B"
                               FontSize="12" />

                        <Label Text="{Binding OpenTickets}"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="#EA580C" />
                    </VerticalStackLayout>
                </Border>

            </Grid>

            <Border
                BackgroundColor="White"
                Padding="18"
                Stroke="#E2E8F0"
                StrokeShape="RoundRectangle 12">

                <VerticalStackLayout Spacing="12">

                    <Label
                        Text="Dodaj lub edytuj zgłoszenie"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="#172554" />

                    <Entry
                        Placeholder="Nazwa zgłoszenia (min. 3 znaki)"
                        Text="{Binding TicketName}"
                        BackgroundColor="#F8FAFC" />

                    <Label Text="{Binding NameError}"
                           TextColor="Red"
                           FontSize="12" />

                    <Editor
                        Placeholder="Opis problemu (min. 10 znaków)"
                        Text="{Binding TicketDescription}"
                        HeightRequest="90"
                        AutoSize="TextChanges"
                        BackgroundColor="#F8FAFC" />

                    <Label Text="{Binding DescriptionError}"
                           TextColor="Red"
                           FontSize="12" />

                    <Picker
                        Title="Wybierz priorytet"
                        SelectedItem="{Binding TicketPriority}"
                        BackgroundColor="#F8FAFC">

                        <Picker.Items>
                            <x:String>Niski</x:String>
                            <x:String>Średni</x:String>
                            <x:String>Wysoki</x:String>
                        </Picker.Items>
                    </Picker>

                    <Label Text="{Binding PriorityError}"
                           TextColor="Red"
                           FontSize="12" />

                    <Button
                        Text="Dodaj zgłoszenie"
                        Command="{Binding AddCommand}"
                        BackgroundColor="#2563EB"
                        TextColor="White"
                        CornerRadius="8" />

                    <Button
                        Text="Zapisz edycję"
                        Command="{Binding SaveEditCommand}"
                        BackgroundColor="#16A34A"
                        TextColor="White"
                        CornerRadius="8" />

                    <Button
                        Text="Anuluj edycję"
                        Command="{Binding CancelEditCommand}"
                        BackgroundColor="#64748B"
                        TextColor="White"
                        CornerRadius="8" />

                    <Label
                        Text="{Binding FormMessage}"
                        TextColor="#2563EB"
                        FontSize="13" />

                </VerticalStackLayout>
            </Border>

            <Label
                Text="Lista zgłoszeń"
                FontSize="22"
                FontAttributes="Bold"
                TextColor="#172554" />

            <CollectionView
                ItemsSource="{Binding Tickets}"
                SelectionMode="Single"
                SelectedItem="{Binding SelectedTicket}">

                <CollectionView.EmptyView>
                    <Label
                        Text="Brak zgłoszeń. Dodaj pierwsze zgłoszenie."
                        Padding="15"
                        TextColor="#64748B"
                        HorizontalTextAlignment="Center" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Ticket">

                        <Border
                            BackgroundColor="White"
                            Padding="14"
                            Margin="0,5"
                            Stroke="#E2E8F0"
                            StrokeShape="RoundRectangle 10">

                            <VerticalStackLayout Spacing="6">

                                <Label
                                    Text="{Binding Name}"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    TextColor="#172554" />

                                <Label
                                    Text="{Binding Description}"
                                    FontSize="13"
                                    TextColor="#475569" />

                                <Grid ColumnDefinitions="*,*">

                                    <Label
                                        Text="{Binding Priority, StringFormat='Priorytet: {0}'}"
                                        TextColor="#1D4ED8"
                                        FontSize="12" />

                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding Status, StringFormat='Status: {0}'}"
                                        TextColor="#EA580C"
                                        FontSize="12" />

                                </Grid>

                                <Label
                                    Text="{Binding Id, StringFormat='Numer zgłoszenia: #{0}'}"
                                    FontSize="11"
                                    TextColor="#94A3B8" />

                            </VerticalStackLayout>
                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <Border
                BackgroundColor="White"
                Padding="16"
                Stroke="#E2E8F0"
                StrokeShape="RoundRectangle 12">

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="Operacje na wybranym zgłoszeniu"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="#172554" />

                    <Button
                        Text="Edytuj zgłoszenie"
                        Command="{Binding StartEditCommand}"
                        BackgroundColor="#0D9488"
                        TextColor="White" />

                    <Button
                        Text="Usuń zgłoszenie"
                        Command="{Binding DeleteCommand}"
                        BackgroundColor="#DC2626"
                        TextColor="White" />

                    <Picker
                        Title="Wybierz nowy status"
                        SelectedItem="{Binding NewStatus}">

                        <Picker.Items>
                            <x:String>Nowe</x:String>
                            <x:String>W trakcie</x:String>
                            <x:String>Zakończone</x:String>
                        </Picker.Items>
                    </Picker>

                    <Button
                        Text="Zmień status"
                        Command="{Binding ChangeStatusCommand}"
                        BackgroundColor="#7C3AED"
                        TextColor="White" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>